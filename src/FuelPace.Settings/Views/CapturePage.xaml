<UserControl x:Class="FuelPace.Settings.Views.CapturePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:FuelPace.Settings"
             xmlns:vm="clr-namespace:FuelPace.App.SettingsUi.ViewModels;assembly=FuelPace.App">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- The mock's table columns (measured on the mock rendered at 1120 px) -->
            <GridLength x:Key="ColLap">87*</GridLength>
            <GridLength x:Key="ColTime">116*</GridLength>
            <GridLength x:Key="ColFuel">117*</GridLength>
            <GridLength x:Key="ColThrottle">132*</GridLength>
            <GridLength x:Key="ColStatus">291*</GridLength>
            <GridLength x:Key="ColAction">83*</GridLength>

            <Style x:Key="Cell" TargetType="TextBlock">
                <Setter Property="Margin" Value="16,9" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>
            <Style x:Key="MonoCell" TargetType="TextBlock" BasedOn="{StaticResource Cell}">
                <Setter Property="FontFamily" Value="{StaticResource Mono}" />
                <Setter Property="FontWeight" Value="Medium" />
            </Style>
            <Style x:Key="Head" TargetType="local:SpacedText" BasedOn="{StaticResource CardTitle}">
                <Setter Property="Margin" Value="16,10" />
            </Style>

            <DataTemplate x:Key="LapRow" DataType="{x:Type vm:LapRowViewModel}">
                <Border BorderBrush="{StaticResource InnerBorder}" BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{StaticResource ColLap}" />
                            <ColumnDefinition Width="{StaticResource ColTime}" />
                            <ColumnDefinition Width="{StaticResource ColFuel}" />
                            <ColumnDefinition Width="{StaticResource ColThrottle}" />
                            <ColumnDefinition Width="{StaticResource ColStatus}" />
                            <ColumnDefinition Width="{StaticResource ColAction}" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource MonoCell}" Text="{Binding LapText}" />
                        <TextBlock Grid.Column="1" Style="{StaticResource MonoCell}" Text="{Binding Time}" />
                        <TextBlock Grid.Column="2" Style="{StaticResource MonoCell}" Text="{Binding Fuel}" />
                        <TextBlock Grid.Column="3" Style="{StaticResource MonoCell}" Text="{Binding FullThrottle}" Foreground="{StaticResource TextNav}" />
                        <TextBlock x:Name="Status" Grid.Column="4" Style="{StaticResource Cell}" Text="{Binding Status}" Foreground="{StaticResource Link}" />
                        <Button Grid.Column="5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="16,9"
                                Content="{Binding ActionText}" Command="{Binding ProfileCommand}" ToolTipService.ShowOnDisabled="True"
                                Visibility="{Binding ActionText, Converter={StaticResource NotEmptyVisible}}">
                            <Button.Style>
                                <!-- Disabled while the capture runs (it is saved when it stops): say so instead of a dead link -->
                                <Style TargetType="Button" BasedOn="{StaticResource LinkButton}">
                                    <Style.Triggers>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="ToolTip" Value="Disponível quando a captura terminar e for salva." />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <AutomationProperties.Name>
                                <MultiBinding StringFormat="{}{0} a volta {1}">
                                    <Binding Path="ActionText" />
                                    <Binding Path="LapText" />
                                </MultiBinding>
                            </AutomationProperties.Name>
                        </Button>
                    </Grid>
                </Border>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Kind}" Value="Invalid">
                        <Setter TargetName="Status" Property="Foreground" Value="{StaticResource Warn}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="InProgress">
                        <Setter TargetName="Status" Property="Foreground" Value="{StaticResource TextMuted}" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="32,24,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title and session, on one baseline -->
        <Grid>
            <TextBlock Style="{StaticResource H1}" Text="Captura" AutomationProperties.HeadingLevel="Level1" />
            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Top" Margin="24,10,0,0" FontSize="14" Foreground="{StaticResource TextNav}"
                       Text="{Binding SessionLine}" TextTrimming="CharacterEllipsis" />
        </Grid>

        <!-- The capture switch and its state -->
        <Border Grid.Row="1" Margin="0,18,0,0" Style="{StaticResource Card}" Padding="20,18">
            <DockPanel>
                <Border DockPanel.Dock="Right" VerticalAlignment="Center" Margin="24,0,0,0" CornerRadius="8" Padding="14,8">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource IdleBg}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Capturing}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource RecBg}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="10" Height="10" Margin="0,0,10,0" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource TextDim}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Capturing}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource Red}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBlock Text="{Binding CounterText}" Style="{StaticResource MonoText}" Foreground="{StaticResource TextValue}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <CheckBox Style="{StaticResource CaptureBox}" HorizontalAlignment="Left" IsChecked="{Binding Capturing, Mode=TwoWay}"
                          IsEnabled="{Binding CanToggle}" AutomationProperties.Name="{Binding CaptureLabel}"
                          AutomationProperties.HelpText="{Binding CaptureHelp}">
                    <StackPanel>
                        <TextBlock Text="{Binding CaptureLabel}" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource Help}" Margin="0,4,0,0" MaxWidth="520" HorizontalAlignment="Left" Text="{Binding CaptureHelp}" />
                    </StackPanel>
                </CheckBox>
            </DockPanel>
        </Border>

        <!-- Summary cards -->
        <Grid Grid.Row="2" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="16,14">
                <StackPanel>
                    <local:SpacedText Style="{StaticResource CardTitle}" Text="{Binding ConsumptionTitle}" />
                    <TextBlock Margin="0,6,0,0" FontFamily="{StaticResource Mono}" FontSize="24" FontWeight="SemiBold">
                        <Run Text="{Binding ConsumptionValue, Mode=OneWay}" /><Run Text=" " /><Run FontSize="14"
                            Foreground="{StaticResource TextMuted}" Text="{Binding ConsumptionUnit, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource Detail}" Margin="0,6,0,0" Text="{Binding ConsumptionDetail}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16,14">
                <StackPanel>
                    <local:SpacedText Style="{StaticResource CardTitle}" Text="{Binding TimeTitle}" />
                    <TextBlock Margin="0,6,0,0" FontFamily="{StaticResource Mono}" FontSize="24" FontWeight="SemiBold" Text="{Binding TimeValue}" />
                    <TextBlock Style="{StaticResource Detail}" Margin="0,6,0,0" Text="{Binding TimeDetail}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource Card}" Padding="16,14">
                <StackPanel>
                    <local:SpacedText Style="{StaticResource CardTitle}" Text="{Binding AutonomyTitle}" />
                    <TextBlock Margin="0,6,0,0" FontFamily="{StaticResource Mono}" FontSize="24" FontWeight="SemiBold">
                        <Run Text="{Binding AutonomyValue, Mode=OneWay}" /><Run Text=" " /><Run FontSize="14"
                            Foreground="{StaticResource TextMuted}" Text="{Binding AutonomyUnit, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource Detail}" Margin="0,6,0,0" Text="{Binding AutonomyDetail}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="6" Style="{StaticResource Card}" Padding="16,14">
                <StackPanel>
                    <local:SpacedText Style="{StaticResource CardTitle}" Text="{Binding BaselineTitle}" />
                    <!-- 24 px Mono line box, so the four cards keep one height and the detail lines align -->
                    <Grid Margin="0,6,0,0" Height="31.7">
                        <TextBlock FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" Text="{Binding BaselineValue}" />
                    </Grid>
                    <TextBlock Style="{StaticResource Detail}" Margin="0,6,0,0" Text="{Binding BaselineDetail}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Laps of the capture -->
        <Border Grid.Row="3" Margin="0,18,0,0" BorderBrush="{StaticResource OuterBorder}" BorderThickness="1" CornerRadius="10">
            <DockPanel>
                <Border DockPanel.Dock="Top" Background="{StaticResource CardBg}" CornerRadius="9,9,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{StaticResource ColLap}" />
                            <ColumnDefinition Width="{StaticResource ColTime}" />
                            <ColumnDefinition Width="{StaticResource ColFuel}" />
                            <ColumnDefinition Width="{StaticResource ColThrottle}" />
                            <ColumnDefinition Width="{StaticResource ColStatus}" />
                            <ColumnDefinition Width="{StaticResource ColAction}" />
                        </Grid.ColumnDefinitions>
                        <local:SpacedText Style="{StaticResource Head}" Text="VOLTA" />
                        <local:SpacedText Grid.Column="1" Style="{StaticResource Head}" Text="TEMPO" />
                        <local:SpacedText Grid.Column="2" Style="{StaticResource Head}" Text="CONSUMO" />
                        <local:SpacedText Grid.Column="3" Style="{StaticResource Head}" Text="PÉ EMBAIXO" />
                        <local:SpacedText Grid.Column="4" Style="{StaticResource Head}" Text="STATUS" />
                        <local:SpacedText Grid.Column="5" Style="{StaticResource Head}" Text="AÇÃO" HorizontalAlignment="Right" />
                    </Grid>
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Laps}" ItemTemplate="{StaticResource LapRow}" Focusable="False"
                                      AutomationProperties.Name="Voltas da captura" />
                        <ContentControl Content="{Binding InProgress}" ContentTemplate="{StaticResource LapRow}" Focusable="False"
                                        Visibility="{Binding InProgress, Converter={StaticResource NotEmptyVisible}}" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
