<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <!-- PERF-05 (docs/perf/agent-memory.md): the shipped code is ReadyToRun; without tiering it is never re-jitted, which
         saves ~4.5 MB of working set (no tier-1 copies, call counting or PGO data) at the same tick time and CPU on CI. -->
    <TieredCompilation>false</TieredCompilation>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <RootNamespace>FuelPace.Agent</RootNamespace>
    <!-- NOTIFYICONDATAW is only generated for a specific architecture; the Agent ships for x64 (the CI runner and every iRacing PC). -->
    <CsWin32PlatformTarget>x64</CsWin32PlatformTarget>
    <ApplicationIcon>..\..\assets\icon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\FuelPace.Core\FuelPace.Core.csproj" />
    <ProjectReference Include="..\FuelPace.App\FuelPace.App.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Decision 8: Inter and JetBrains Mono (OFL), loaded by DirectWrite from memory; nothing is installed. -->
    <EmbeddedResource Include="..\..\assets\fonts\*.ttf" LogicalName="FuelPace.Fonts.%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\icon.ico" LogicalName="FuelPace.icon.ico" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.369">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Vortice.Direct2D1" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DirectComposition" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
  </ItemGroup>
</Project>
